# The node and php binaries this project uses to run its own differential tests.
# They are 262 MB, belong to the machine, and are never part of the app.
tools/

node_modules/

# Generated by `npm run build` (scripts/generate-static.mjs wipes and rebuilds it).
site/public/

# Runtime state: job records, build state, relay media, throttle buckets.
site/storage/

*.log
.env
.env.*
.DS_Store

# The reference php app, cloned separately: git clone https://github.com/pritomsarkar2022-commits/downloader-website-.git source
# The parity harness needs it on disk; the port itself does not.
source/

# Raw capture of the php pages, before {{SITE_URL}} placeholders were introduced.
# Superseded by site/templates, and the untouched original lives in source/views.
capture/
